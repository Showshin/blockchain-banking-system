{
  "name": "tich-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TÍCH on-chain term-deposit contracts and tests",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "compile": "hardhat build",
    "typecheck": "tsc --noEmit",
    "export:abis": "hardhat build && tsx scripts/export-abis.ts",
    "test": "hardhat test",
    "coverage": "hardhat test --coverage",
    "deploy:testnet:dry": "hardhat run scripts/deploy-dry.ts --network testnet",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network testnet",
    "verify:testnet": "hardhat run scripts/verify-deployment.ts --network testnet",
    "testnet:e2e:immediate": "hardhat run scripts/e2e/immediate.ts --network testnet",
    "testnet:e2e:mature": "hardhat run scripts/e2e/mature.ts --network testnet",
    "testnet:e2e:auto-renew": "hardhat run scripts/e2e/auto-renew.ts --network testnet",
    "testnet:e2e:status": "hardhat run scripts/e2e/status.ts --network testnet",
    "configure:frontend": "tsx scripts/configure-frontend.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.1",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.13",
    "@nomicfoundation/hardhat-mocha": "^4.0.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.12",
    "@nomicfoundation/hardhat-verify": "^3.1.4",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.5",
    "chai": "6.3.0",
    "ethers": "6.17.0",
    "hardhat": "3.21.1",
    "mocha": "12.0.3",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
