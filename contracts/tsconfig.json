{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node", "mocha"]
  },
  "include": [
    "./hardhat.config.ts",
    "./config/**/*.ts",
    "./scripts/**/*.ts",
    "./test/**/*.ts"
  ],
  "exclude": [
    "./node_modules",
    "./artifacts",
    "./cache",
    "./coverage"
  ]
}
