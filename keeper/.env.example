# JSON-RPC endpoint for Sepolia. Any standard RPC provider works.
# Etherscan's proxy API is not a drop-in RPC: the free tier allows 5 requests/second.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111

# Bot wallet. autoRenewDeposit is permissionless, so this key needs no role and no USDC,
# only enough ETH for gas.
KEEPER_PRIVATE_KEY=0x

# Contract addresses of the deployment the bot should watch.
# These are the current Sepolia addresses; replace them for another deployment.
CORE_ADDRESS=0x10E9eDb55C0cD100F67DEc8b558649e66B263c79
VAULT_ADDRESS=0x1c5533537118320021b5795473cb2552d11Bf9B5
USDC_ADDRESS=0x460193B776F34D63413d358203516CA44d78ecfE

# Optional fallback: when the three addresses above are empty, the bot reads them
# from this manifest instead. Leave it commented out when the addresses are set.
# MANIFEST_PATH=../contracts/deployments/testnet.json

# Behaviour
# KEEPER_MODE=watch keeps the bot running; `once` runs a single pass and exits.
KEEPER_MODE=watch
KEEPER_DRY_RUN=1
KEEPER_INTERVAL_SECONDS=300
KEEPER_MAX_RENEWALS_PER_RUN=10
# How many waiting deposits to print per pass. 0 prints all of them.
KEEPER_LOG_WAITING_LIMIT=0
# 1 forces the table view, 0 forces plain lines; unset follows the terminal.
KEEPER_TABLE=
KEEPER_MAX_COST_ETH=0.005
KEEPER_MIN_BALANCE_RESERVE_ETH=0.005

# Gas caps
MAX_BASE_FEE_GWEI=1
MAX_FEE_GWEI=2
MAX_PRIORITY_FEE_GWEI=0.1
GAS_LIMIT_MULTIPLIER_BPS=12000
